OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=change-me

CONNECTOR_ID=galileo-signals-observed-domains
CONNECTOR_NAME=Galileo Signals
CONNECTOR_SCOPE=galileo,galileo-signals,domain-name,email-message,indicator
CONNECTOR_LOG_LEVEL=info
CONNECTOR_DURATION_PERIOD=PT1H

GALILEO_API_TOKEN=change-me
GALILEO_FEED_URL=https://galileosignals.com/api/observed_domains
GALILEO_AUTH_HEADER=Authorization
GALILEO_AUTH_SCHEME=Bearer
GALILEO_FIRST_SEEN=24hours
GALILEO_CONFIDENCE=medium
GALILEO_SOURCE=
GALILEO_DOMAIN_AGE=
GALILEO_INCLUDE_CONTEXT=false
GALILEO_USE_ROLLUP=true
GALILEO_EMAIL_DETAIL_BASE_URL=https://galileosignals.com/email
GALILEO_SIZE=500
GALILEO_INTERVAL=3600
GALILEO_RUN_ONCE=false
GALILEO_OPENCTI_DRY_RUN=false
GALILEO_VERIFY_SSL=true
GALILEO_TLP=TLP:AMBER
GALILEO_CREATE_REPORTS=true
